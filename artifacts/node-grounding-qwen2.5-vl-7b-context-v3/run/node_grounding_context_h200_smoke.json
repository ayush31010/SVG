{
  "base_model": "Qwen/Qwen2.5-VL-7B-Instruct",
  "data_dir": "data/node_grounding-context-v3",
  "training_output_dir": "checkpoints/node-grounding-context-v3-smoke",
  "seed": 20260816,
  "max_train_samples": 4,
  "max_val_samples": 2,
  "honest_eval_require_distractor": true,
  "min_pixels": 401408,
  "max_pixels": 1605632,
  "max_seq_len": 3072,
  "qlora": false,
  "dtype": "bfloat16",
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "lora_target_module_patterns": {
    "language_attention": [
      "(?:^|\\.)(?:language_model|model)\\.layers\\.\\d+\\.self_attn\\.(?:q_proj|k_proj|v_proj|o_proj)$"
    ],
    "vision_attention": [
      "(?:^|\\.)visual\\.blocks\\.\\d+\\.attn\\.(?:qkv|proj)$"
    ],
    "vision_projector": [
      "(?:^|\\.)visual\\.merger\\.mlp\\.(?:0|2)$"
    ]
  },
  "lora_required_module_families": [
    "language_attention",
    "vision_attention",
    "vision_projector"
  ],
  "gradient_checkpointing": true,
  "attn_implementation": "sdpa",
  "batch_size": 2,
  "eval_batch_size": 1,
  "grad_accum": 1,
  "learning_rate": 0.0001,
  "num_epochs": 1,
  "logging_steps": 1,
  "save_total_limit": 1,
  "eval_max_new_tokens": 32,
  "evaluation_ablations": [
    "none"
  ],
  "dataloader_num_workers": 0,
  "report_to": "none"
}
