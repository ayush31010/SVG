{
  "base_model": "Qwen/Qwen2.5-VL-3B-Instruct",
  "bench_root": "SVGEditBench",
  "data_dir": "data/node_grounding-smoke",
  "training_output_dir": "checkpoints/node-grounding-smoke",
  "tasks": [
    "change_color",
    "set_contour"
  ],
  "seed": 20260814,
  "split_ratios": {
    "train": 0.6,
    "val": 0.2,
    "test": 0.2
  },
  "max_examples_per_split": 2,
  "candidate_count": 4,
  "max_targets": 2,
  "label_permutations": 1,
  "shuffle_candidate_labels": true,
  "honest_eval_require_distractor": true,
  "render_size": 64,
  "crop_padding": 0.15,
  "max_seq_len": 512,
  "qlora": true,
  "dtype": "bfloat16",
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.05,
  "lora_target_module_patterns": {
    "language_attention": [
      "(?:^|\\.)(?:language_model|model)\\.layers\\.\\d+\\.self_attn\\.(?:q_proj|k_proj|v_proj|o_proj)$"
    ],
    "vision_attention": [
      "(?:^|\\.)visual\\.blocks\\.\\d+\\.attn\\.(?:qkv|proj)$"
    ],
    "vision_projector": [
      "(?:^|\\.)visual\\.merger\\.mlp\\.(?:0|2)$"
    ]
  },
  "lora_required_module_families": [
    "language_attention",
    "vision_attention",
    "vision_projector"
  ],
  "gradient_checkpointing": true,
  "batch_size": 1,
  "eval_batch_size": 1,
  "grad_accum": 1,
  "learning_rate": 0.0002,
  "num_epochs": 1,
  "logging_steps": 1,
  "save_total_limit": 1,
  "eval_max_new_tokens": 24,
  "max_train_samples": 2,
  "max_val_samples": 2,
  "dataloader_num_workers": 0,
  "report_to": "none"
}
